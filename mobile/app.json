{
  "expo": {
    "name": "VOX Mobile",
    "slug": "vox-mobile",
    "scheme": "vox",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voxchat.mobile"
    },
    "android": {
      "package": "com.voxchat.mobile",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E1A"
      }
    },
    "plugins": [
      "expo-dev-client"
    ],
    "newArchEnabled": true
  }
}
