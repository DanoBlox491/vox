{
  "expo": {
    "name": "VOX Mobile",
    "slug": "vox-mobile",
    "scheme": "voxmobile",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.voxchat.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.voxchat.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A"
      }
    },
    "plugins": [
      "expo-dev-client"
    ],
    "extra": {
      "voxBackend": "existing-firebase-project"
    }
  }
}
