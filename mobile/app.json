{
  "expo": {
    "name": "VOX Mobile",
    "slug": "vox-mobile",
    "scheme": "vox",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voxchat.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "VOX uses your camera when you choose to join a video call.",
        "NSMicrophoneUsageDescription": "VOX uses your microphone when you choose to join a voice or video call."
      }
    },
    "android": {
      "package": "com.voxchat.mobile",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-dev-client"
    ],
    "newArchEnabled": true
  }
}
